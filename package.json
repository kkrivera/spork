{
  "name": "spork",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "readme-sync:check": "tsx tools/readme-sync/check.ts",
    "release:bump": "tsx tools/release/bump-version.ts",
    "package:binary": "tsx tools/package-binary/build.ts",
    "package:all": "tsx tools/package-binary/build-all.ts",
    "package:mac": "tsx tools/package-binary/build-all.ts --platform darwin",
    "package:win": "tsx tools/package-binary/build-all.ts --platform win32",
    "package:linux": "tsx tools/package-binary/build-all.ts --platform linux",
    "homebrew:update-formula": "tsx tools/homebrew-formula/generate-formula.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.13.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
